# Server Configuration
NODE_ENV=development
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/growthmonitor?sslmode=require

# Redis (Upstash or self-hosted)
REDIS_URL=rediss://default:password@host:6379

# JWT Authentication
ACCESS_TOKEN_SECRET=your-super-secret-key-min-32-characters
REFRESH_TOKEN_SECRET=your-refresh-secret-key-min-32-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google Cloud Storage (Optional - for file uploads)
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-bucket-name
GCP_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# AI Worker URL
AI_API_URL=http://localhost:8000
