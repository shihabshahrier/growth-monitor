# Database (PostgreSQL) - Same as API server
DATABASE_URL=postgresql://user:password@host:5432/growthmonitor?sslmode=require

# Redis (Upstash or self-hosted) - Same as API server
REDIS_URL=rediss://default:password@host:6379

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
