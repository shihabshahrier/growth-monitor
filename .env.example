# ==========================================
# GrowthMonitor - Docker Compose Environment
# ==========================================

# PostgreSQL (for local docker-compose only)
POSTGRES_PASSWORD=postgres

# Database Connection (use external service in production)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/growthmonitor

# Redis Connection (use Upstash or Redis Cloud in production)
REDIS_URL=redis://redis:6379

# JWT Authentication (MUST CHANGE IN PRODUCTION)
ACCESS_TOKEN_SECRET=change-this-to-a-strong-secret-min-32-characters
REFRESH_TOKEN_SECRET=change-this-to-another-strong-secret-min-32-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google Cloud Storage (Optional - for file uploads)
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-bucket-name
GCP_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# AI Worker URL (for production docker-compose.prod.yml)
AI_API_URL=http://ai_worker:8000

# Frontend API URL (for production build)
VITE_API_URL=http://localhost:8080/api
